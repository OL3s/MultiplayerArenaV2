horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Content/ListPanel"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
size_flags_vertical = 3

[node name="List" type="VBoxContainer" parent="Content/ListPanel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Footer" type="HBoxContainer" parent="Content/ListPanel"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="CloseButton" type="Button" parent="Content/ListPanel/Footer"]
