[ext_resource type="StyleBox" path="res://assets/ui/styles/lobby_revert_button.tres" id="5_clear_style"]
[ext_resource type="StyleBox" path="res://assets/ui/styles/lobby_apply_button.tres" id="6_apply_style"]

[node name="GameModePlaylistOverlay" type="PanelContainer"]
custom_minimum_size = Vector2(520, 420)
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -210.0
offset_right = 260.0
offset_bottom = 210.0
script = ExtResource("1_playlist")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ListPanel" type="VBoxContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="Content/ListPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Game Order"
horizontal_alignment = 1

[node name="DescriptionLabel" type="Label" parent="Content/ListPanel"]
layout_mode = 2
text = "Add modes to the list and move them into the order they should appear."
